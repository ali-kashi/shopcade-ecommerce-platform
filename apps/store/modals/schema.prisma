    // This is your Prisma schema file,
    // learn more about it in the docs: https://pris.ly/d/prisma-schema

    generator client {
      provider = "prisma-client-js"
    }

    datasource db {
      provider = "mysql" // یا "mysql", "sqlite", "sqlserver", "mongodb"
      url      = env("DATABASE_URL") // آدرس اتصال به دیتابیس از متغیرهای محیطی
    }

    // تعریف مدل Product
    model Product {
      id    Int     @id @default(autoincrement())
      title  String  
      description String 
      image   String
      category   String 
    }